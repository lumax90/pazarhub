NODE_ENV=development
API_PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATA_DIR=.data
REGISTRATION_ENABLED=true
EMBEDDED_WORKER=true
INTEGRATION_NAME=Pazarhub

# Password reset email (optional for local development).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=account
# SMTP_PASSWORD=password
# MAIL_FROM=Pazarhub <noreply@example.com>

# Development falls back to local PGlite if DATABASE_URL is not set.
# Production requires external PostgreSQL and a stable 32-byte hexadecimal key.
# DATABASE_URL=postgresql://pazarhub:password@localhost:5432/pazarhub
# ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32-hex
