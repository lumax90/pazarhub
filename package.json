{
  "name": "pazarhub",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker-entry.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "npm run check:theme && tsc --noEmit && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node server-dist/index.js",
    "worker": "node server-dist/worker-entry.js",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && npm run check:theme",
    "check:theme": "node scripts/theme-contract.mjs",
    "theme:apply": "node scripts/apply-theme.mjs",
    "format": "prettier --write src server scripts tests e2e *.ts *.json *.mjs *.yaml",
    "format:check": "prettier --check src server scripts tests e2e *.ts *.json *.mjs *.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:all && playwright test"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "bwip-js": "4.11.4",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
